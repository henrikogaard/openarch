# Copy to `.env` and adjust. Nothing here is required for local-first use.

# ── Web build ────────────────────────────────────────────────────────────────
# Server endpoint used when the app is switched to Server mode.
VITE_API_URL=http://localhost:8080/api

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# Where workspaces are persisted.
OPENARCH_DATA=./data/models.json
# Comma-separated allowed CORS origins for the web app.
# Default: local loopback origins on any port (covers the Vite dev server and
# the server&#39;s own hosted build). Use "true" only if you understand the
# drive-by read/write exposure of reflecting arbitrary origins.
OPENARCH_CORS_ORIGIN=

# Set to true to require a bearer token on every request.
OPENARCH_REQUIRE_AUTH=false
# Static tokens: {"token":{"subject":"alice","displayName":"Alice"}}
# The first subject becomes the owner of seeded workspaces unless OPENARCH_ADMIN is set.
OPENARCH_TOKENS=
# Alternatively accept HS256 JWTs (with a `sub` claim) signed with this secret.
OPENARCH_JWT_SECRET=
# Bootstrap owner subject for seeded workspaces. IMPORTANT: without this
# (and no static tokens), an OIDC-only deployment treats every real user as
# a non-member of existing workspaces — set it to a real IdP subject.
OPENARCH_ADMIN=

# ── MCP server ───────────────────────────────────────────────────────────────
# Attach the agent to a running server (recommended).
OPENARCH_API_URL=
# Required when the server sets OPENARCH_REQUIRE_AUTH=true.
OPENARCH_TOKEN=
# Or work on a single local file instead of a server.
OPENARCH_MODEL_FILE=

# ── Owner bootstrap (spec A1) ────────────────────────────────────────────────
# On first boot with auth required, a one-time owner token is printed to the
# logs; set OPENARCH_ADMIN_TOKEN to reset it later.
OPENARCH_ADMIN_TOKEN=

# ── Sessions (spec A4) ──────────────────────────────────────────────────────
# Browser/CLI sessions expire after this many days of inactivity (default 30).
OPENARCH_SESSION_IDLE_DAYS=

# ── OIDC login (spec A5) ─────────────────────────────────────────────────────
# Public-client Authorization Code + PKCE; the IdP token is verified with the
# existing RS256/JWKS configuration above.
OPENARCH_OIDC_CLIENT_ID=
OPENARCH_OIDC_REDIRECT_URI=

# ── Invites (spec A3) ─────────────────────────────────────────────────────────
# Defaults: TTL 7 days, PII retention 30 days after use, cap 100 outstanding.
OPENARCH_INVITE_TTL_DAYS=
OPENARCH_INVITE_RETENTION_DAYS=
OPENARCH_INVITE_CAP=

# ── Mail (spec D1) ────────────────────────────────────────────────────────────
# Runtime settings live in data/config.json (the admin setup screen); these
# env values are the first-boot bootstrap copies.
OPENARCH_MAIL_PROVIDER=
OPENARCH_RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# ── Route parity (spec E1) ────────────────────────────────────────────────────
# Fatal at boot when a registered route lacks a minRole expectation.
OPENARCH_ENFORCE_ROUTE_PARITY=
