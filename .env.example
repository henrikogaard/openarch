# Copy to `.env` and adjust. Nothing here is required for local-first use.

# ── Web build ────────────────────────────────────────────────────────────────
# Server endpoint used when the app is switched to Server mode.
VITE_API_URL=http://localhost:8080/api

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# Where workspaces are persisted.
OPENARCH_DATA=./data/models.json

# Set to true to require a bearer token on every request.
OPENARCH_REQUIRE_AUTH=false
# Static tokens: {"token":{"subject":"alice","displayName":"Alice"}}
# The first subject becomes the owner of seeded workspaces unless OPENARCH_ADMIN is set.
OPENARCH_TOKENS=
# Alternatively accept HS256 JWTs (with a `sub` claim) signed with this secret.
OPENARCH_JWT_SECRET=
# Bootstrap owner subject for seeded workspaces.
OPENARCH_ADMIN=

# ── MCP server ───────────────────────────────────────────────────────────────
# Attach the agent to a running server (recommended).
OPENARCH_API_URL=
# Required when the server sets OPENARCH_REQUIRE_AUTH=true.
OPENARCH_TOKEN=
# Or work on a single local file instead of a server.
OPENARCH_MODEL_FILE=
