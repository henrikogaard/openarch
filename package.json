{
  "name": "openarch",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, browser-based ArchiMate® modeling platform",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @openarch/web",
    "dev:server": "npm run dev -w @openarch/server",
    "cli": "tsx apps/cli/src/index.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "build": "npm run build -w @openarch/web && npm run build -w @openarch/server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^5.1.0"
  }
}
